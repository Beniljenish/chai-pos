{
  "_about": "Shared GST test vectors. backend/app/services/gst.py AND the PWA's TypeScript port must both pass every case. All money in integer paise. rate_bp: 500 = 5%. Change a case only with a reason in the commit message.",
  "cases": [
    {
      "name": "tea 20 rupees inclusive x1: taxable adjusted down by 1 paise so the customer pays exactly 20",
      "gst_type": "regular",
      "lines": [{"unit_price_paise": 2000, "qty": 1, "gst_rate_bp": 500, "tax_inclusive": true}],
      "expect_lines": [{"gross": 2000, "taxable": 1904, "cgst": 48, "sgst": 48, "total": 2000, "discount": 0}],
      "expect_bill": {"taxable": 1904, "cgst": 48, "sgst": 48, "subtotal": 2000, "round_off": 0, "total": 2000, "discount": 0}
    },
    {
      "name": "tea x3: tax is computed on the line gross, not per unit",
      "gst_type": "regular",
      "lines": [{"unit_price_paise": 2000, "qty": 3, "gst_rate_bp": 500, "tax_inclusive": true}],
      "expect_lines": [{"gross": 6000, "taxable": 5714, "cgst": 143, "sgst": 143, "total": 6000, "discount": 0}],
      "expect_bill": {"taxable": 5714, "cgst": 143, "sgst": 143, "subtotal": 6000, "round_off": 0, "total": 6000, "discount": 0}
    },
    {
      "name": "juice 60 + Large modifier 10, inclusive: modifier price is part of the gross",
      "gst_type": "regular",
      "lines": [{"unit_price_paise": 6000, "qty": 1, "gst_rate_bp": 500, "tax_inclusive": true, "modifier_deltas_paise": [1000]}],
      "expect_lines": [{"gross": 7000, "taxable": 6666, "cgst": 167, "sgst": 167, "total": 7000, "discount": 0}],
      "expect_bill": {"taxable": 6666, "cgst": 167, "sgst": 167, "subtotal": 7000, "round_off": 0, "total": 7000, "discount": 0}
    },
    {
      "name": "exclusive price: tax added on top",
      "gst_type": "regular",
      "lines": [{"unit_price_paise": 10000, "qty": 1, "gst_rate_bp": 500, "tax_inclusive": false}],
      "expect_lines": [{"gross": 10000, "taxable": 10000, "cgst": 250, "sgst": 250, "total": 10500, "discount": 0}],
      "expect_bill": {"taxable": 10000, "cgst": 250, "sgst": 250, "subtotal": 10500, "round_off": 0, "total": 10500, "discount": 0}
    },
    {
      "name": "exclusive odd price: bill rounds to the nearest rupee, difference in round_off",
      "gst_type": "regular",
      "lines": [{"unit_price_paise": 3333, "qty": 1, "gst_rate_bp": 500, "tax_inclusive": false}],
      "expect_lines": [{"gross": 3333, "taxable": 3333, "cgst": 83, "sgst": 83, "total": 3499, "discount": 0}],
      "expect_bill": {"taxable": 3333, "cgst": 83, "sgst": 83, "subtotal": 3499, "round_off": 1, "total": 3500, "discount": 0}
    },
    {
      "name": "18 percent inclusive",
      "gst_type": "regular",
      "lines": [{"unit_price_paise": 4000, "qty": 1, "gst_rate_bp": 1800, "tax_inclusive": true}],
      "expect_lines": [{"gross": 4000, "taxable": 3390, "cgst": 305, "sgst": 305, "total": 4000, "discount": 0}],
      "expect_bill": {"taxable": 3390, "cgst": 305, "sgst": 305, "subtotal": 4000, "round_off": 0, "total": 4000, "discount": 0}
    },
    {
      "name": "composition shop: no GST charged",
      "gst_type": "composition",
      "lines": [{"unit_price_paise": 2000, "qty": 2, "gst_rate_bp": 500, "tax_inclusive": true}],
      "expect_lines": [{"gross": 4000, "taxable": 4000, "cgst": 0, "sgst": 0, "total": 4000, "discount": 0}],
      "expect_bill": {"taxable": 4000, "cgst": 0, "sgst": 0, "subtotal": 4000, "round_off": 0, "total": 4000, "discount": 0}
    },
    {
      "name": "unregistered shop: no GST even on an exclusive price",
      "gst_type": "unregistered",
      "lines": [{"unit_price_paise": 3333, "qty": 1, "gst_rate_bp": 500, "tax_inclusive": false}],
      "expect_lines": [{"gross": 3333, "taxable": 3333, "cgst": 0, "sgst": 0, "total": 3333, "discount": 0}],
      "expect_bill": {"taxable": 3333, "cgst": 0, "sgst": 0, "subtotal": 3333, "round_off": -33, "total": 3300, "discount": 0}
    },
    {
      "name": "complimentary item at zero price",
      "gst_type": "regular",
      "lines": [{"unit_price_paise": 0, "qty": 1, "gst_rate_bp": 500, "tax_inclusive": true}],
      "expect_lines": [{"gross": 0, "taxable": 0, "cgst": 0, "sgst": 0, "total": 0, "discount": 0}],
      "expect_bill": {"taxable": 0, "cgst": 0, "sgst": 0, "subtotal": 0, "round_off": 0, "total": 0, "discount": 0}
    },
    {
      "name": "mixed bill: each line computed separately, then summed",
      "gst_type": "regular",
      "lines": [{"unit_price_paise": 2000, "qty": 1, "gst_rate_bp": 500, "tax_inclusive": true}, {"unit_price_paise": 6000, "qty": 1, "gst_rate_bp": 500, "tax_inclusive": true, "modifier_deltas_paise": [1000]}, {"unit_price_paise": 3333, "qty": 1, "gst_rate_bp": 500, "tax_inclusive": false}],
      "expect_lines": [{"gross": 2000, "taxable": 1904, "cgst": 48, "sgst": 48, "total": 2000, "discount": 0}, {"gross": 7000, "taxable": 6666, "cgst": 167, "sgst": 167, "total": 7000, "discount": 0}, {"gross": 3333, "taxable": 3333, "cgst": 83, "sgst": 83, "total": 3499, "discount": 0}],
      "expect_bill": {"taxable": 11903, "cgst": 298, "sgst": 298, "subtotal": 12499, "round_off": 1, "total": 12500, "discount": 0}
    },
    {
      "name": "half-rupee subtotal rounds up",
      "gst_type": "unregistered",
      "lines": [{"unit_price_paise": 1050, "qty": 1, "gst_rate_bp": 0, "tax_inclusive": true}],
      "expect_lines": [{"gross": 1050, "taxable": 1050, "cgst": 0, "sgst": 0, "total": 1050, "discount": 0}],
      "expect_bill": {"taxable": 1050, "cgst": 0, "sgst": 0, "subtotal": 1050, "round_off": 50, "total": 1100, "discount": 0}
    },
    {
      "name": "line discount: two teas at 20, 4 rupees off, inclusive: GST is inside the 36 the customer pays",
      "gst_type": "regular",
      "lines": [{"unit_price_paise": 2000, "qty": 2, "gst_rate_bp": 500, "tax_inclusive": true, "discount_paise": 400}],
      "expect_lines": [{"gross": 4000, "discount": 400, "taxable": 3428, "cgst": 86, "sgst": 86, "total": 3600}],
      "expect_bill": {"discount": 400, "taxable": 3428, "cgst": 86, "sgst": 86, "subtotal": 3600, "round_off": 0, "total": 3600}
    },
    {
      "name": "bill discount 10 rupees over a 5% inclusive tea and a 12% exclusive item: shared 2.50 / 7.50 by value, each taxed at its own rate",
      "gst_type": "regular",
      "bill_discount_paise": 1000,
      "lines": [{"unit_price_paise": 2000, "qty": 1, "gst_rate_bp": 500, "tax_inclusive": true}, {"unit_price_paise": 6000, "qty": 1, "gst_rate_bp": 1200, "tax_inclusive": false}],
      "expect_lines": [{"gross": 2000, "discount": 250, "taxable": 1666, "cgst": 42, "sgst": 42, "total": 1750}, {"gross": 6000, "discount": 750, "taxable": 5250, "cgst": 315, "sgst": 315, "total": 5880}],
      "expect_bill": {"discount": 1000, "taxable": 6916, "cgst": 357, "sgst": 357, "subtotal": 7630, "round_off": -30, "total": 7600}
    },
    {
      "name": "bill discount of 1 rupee over three equal lines: 34 + 33 + 33 paise, the spare paise to the first line",
      "gst_type": "unregistered",
      "bill_discount_paise": 100,
      "lines": [{"unit_price_paise": 1000, "qty": 1, "gst_rate_bp": 0, "tax_inclusive": true}, {"unit_price_paise": 1000, "qty": 1, "gst_rate_bp": 0, "tax_inclusive": true}, {"unit_price_paise": 1000, "qty": 1, "gst_rate_bp": 0, "tax_inclusive": true}],
      "expect_lines": [{"gross": 1000, "discount": 34, "taxable": 966, "cgst": 0, "sgst": 0, "total": 966}, {"gross": 1000, "discount": 33, "taxable": 967, "cgst": 0, "sgst": 0, "total": 967}, {"gross": 1000, "discount": 33, "taxable": 967, "cgst": 0, "sgst": 0, "total": 967}],
      "expect_bill": {"discount": 100, "taxable": 2900, "cgst": 0, "sgst": 0, "subtotal": 2900, "round_off": 0, "total": 2900}
    },
    {
      "name": "a line discount and a bill discount: the bill discount is shared over what is left after line discounts",
      "gst_type": "composition",
      "bill_discount_paise": 500,
      "lines": [{"unit_price_paise": 2000, "qty": 1, "gst_rate_bp": 500, "tax_inclusive": true, "discount_paise": 1000}, {"unit_price_paise": 4000, "qty": 1, "gst_rate_bp": 500, "tax_inclusive": true}],
      "expect_lines": [{"gross": 2000, "discount": 1100, "taxable": 900, "cgst": 0, "sgst": 0, "total": 900}, {"gross": 4000, "discount": 400, "taxable": 3600, "cgst": 0, "sgst": 0, "total": 3600}],
      "expect_bill": {"discount": 1500, "taxable": 4500, "cgst": 0, "sgst": 0, "subtotal": 4500, "round_off": 0, "total": 4500}
    },
    {
      "name": "everything free: a full discount leaves nothing to tax",
      "gst_type": "regular",
      "lines": [{"unit_price_paise": 2000, "qty": 1, "gst_rate_bp": 500, "tax_inclusive": true, "discount_paise": 2000}],
      "expect_lines": [{"gross": 2000, "discount": 2000, "taxable": 0, "cgst": 0, "sgst": 0, "total": 0}],
      "expect_bill": {"discount": 2000, "taxable": 0, "cgst": 0, "sgst": 0, "subtotal": 0, "round_off": 0, "total": 0}
    },
    {
      "name": "40 percent item next to a 5 percent tea: each line at its own rate (Badam milk 100 at 40% inclusive: 71.42 + 14.29 + 14.29)",
      "gst_type": "regular",
      "lines": [
        {"unit_price_paise": 2000, "qty": 1, "gst_rate_bp": 500, "tax_inclusive": true},
        {"unit_price_paise": 10000, "qty": 1, "gst_rate_bp": 4000, "tax_inclusive": true}
      ],
      "expect_lines": [
        {"gross": 2000, "discount": 0, "taxable": 1904, "cgst": 48, "sgst": 48, "total": 2000},
        {"gross": 10000, "discount": 0, "taxable": 7142, "cgst": 1429, "sgst": 1429, "total": 10000}
      ],
      "expect_bill": {"discount": 0, "taxable": 9046, "cgst": 1477, "sgst": 1477, "subtotal": 12000, "round_off": 0, "total": 12000}
    }
  ],
  "errors": [
    {
      "name": "zero quantity",
      "gst_type": "regular",
      "lines": [{"unit_price_paise": 2000, "qty": 0, "gst_rate_bp": 500, "tax_inclusive": true}]
    },
    {
      "name": "negative quantity",
      "gst_type": "regular",
      "lines": [{"unit_price_paise": 2000, "qty": -1, "gst_rate_bp": 500, "tax_inclusive": true}]
    },
    {
      "name": "price negative after modifier",
      "gst_type": "regular",
      "lines": [{"unit_price_paise": 500, "qty": 1, "gst_rate_bp": 500, "tax_inclusive": true, "modifier_deltas_paise": [-1000]}]
    },
    {
      "name": "negative base price",
      "gst_type": "regular",
      "lines": [{"unit_price_paise": -1, "qty": 1, "gst_rate_bp": 500, "tax_inclusive": true}]
    },
    {
      "name": "rate above 40 percent",
      "gst_type": "regular",
      "lines": [{"unit_price_paise": 2000, "qty": 1, "gst_rate_bp": 4001, "tax_inclusive": true}]
    },
    {
      "name": "empty bill",
      "gst_type": "regular",
      "lines": []
    },
    {
      "name": "line discount bigger than the line",
      "gst_type": "regular",
      "lines": [{"unit_price_paise": 2000, "qty": 1, "gst_rate_bp": 500, "tax_inclusive": true, "discount_paise": 2001}]
    },
    {
      "name": "negative line discount",
      "gst_type": "regular",
      "lines": [{"unit_price_paise": 2000, "qty": 1, "gst_rate_bp": 500, "tax_inclusive": true, "discount_paise": -1}]
    },
    {
      "name": "bill discount bigger than the bill",
      "gst_type": "regular",
      "bill_discount_paise": 2001,
      "lines": [{"unit_price_paise": 2000, "qty": 1, "gst_rate_bp": 500, "tax_inclusive": true}]
    }
  ]
}
